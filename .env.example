NODE_ENV=development
PORT=3000
RUNTIME_ROLE=api
NODE_MARKET_PRODUCER_MODE=DRY_RUN
PGHOST=/var/run/postgresql
PGDATABASE=btc_analysis
PGUSER=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
REPORT_EMAIL_TO=
INITIAL_EQUITY_USD=100
ALLOCATION_RATE=0.20
LEVERAGE=1.8
DIRECTION_THRESHOLD=0.55
BYBIT_PUBLIC_WS_URL=wss://stream.bybit.com/v5/public/inverse
PYTHON_RESEARCH_ROOT=
# Shadow launch is intentionally disabled unless an existing, approved activation UUID
# is supplied twice under the dedicated bybit_shadow OS/DB role. Do not set for API/producer.
SHADOW_ACTIVATION_ID=
SHADOW_LAUNCH_APPROVAL=
PYTHON_EXECUTABLE=
BTCUSD_INVERSE_LOT_SIZE=
